# Copy to .env and fill in. Public market data needs NO keys — these are optional.

# Exchange (read-only keys ONLY — never trade/withdraw permissions)
BYBIT_API_KEY=
BYBIT_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Universe
TOP_N=20
QUOTE=USDT

# DB (SQLite path inside the container/app)
DB_PATH=data/trader.db

# Delivery (P3) — get a token from @BotFather; chat_id from @userinfobot or getUpdates.
# Leave blank to print the report to the console only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Deferred (optional, later): LLM narration + journal analysis
# ANTHROPIC_API_KEY=
