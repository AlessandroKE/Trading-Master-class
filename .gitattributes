# Normalize line endings: store LF in the repo, check out LF everywhere.
# Silences the "LF will be replaced by CRLF" warnings on Windows.
* text=auto eol=lf

# Explicit for common text types
*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.env.example text eol=lf
Dockerfile   text eol=lf

# Binary / data — never touch
*.db     binary
*.sqlite binary
*.png    binary
*.jpg    binary
*.ico    binary
